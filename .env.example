# Configurações da sua rifa (preencha e use no deploy)
# Copie este arquivo para .env e ajuste os valores.

# Token de acesso do Mercado Pago (conta de testes ou produção)
# Crie em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# URL pública do seu site (usada para o webhook do Mercado Pago)
# Em produção: https://seu-app.onrender.com
# Em local/dev: use um túnel como ngrok: https://xxxx.ngrok.io
PUBLIC_URL=http://localhost:3000

# Senha do painel admin
ADMIN_PASS=admin123

# Porta (Render/Railway definem automaticamente via process.env.PORT)
PORT=3000

# Deixe "true" para modo demo (sem Mercado Pago): gera Pix fake e botão "simular pagamento"
MOCK=false
